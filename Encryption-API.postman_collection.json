									"});",
									"",
									"pm.test('Response contains timestamp', function () {",
									"    pm.expect(jsonData).to.have.property('timestamp');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"health"
							]
						},
						"description": "Check API availability and health status.\n\n**Authentication:** Not required\n\n**Returns:**\n- `status`: \"UP\" if API is healthy\n- `timestamp`: Current server time"
					},
					"response": []
				}
			],
			"description": "Health check endpoint to verify API availability."
