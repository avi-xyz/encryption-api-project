				{
					"name": "Encrypt - Sample API Key",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const jsonData = pm.response.json();",
									"",
									"if (jsonData.id) {",
									"    pm.environment.set('encrypted_id', jsonData.id);",
									"}",
									"",
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{id_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"plainText\": \"API_KEY=sk-1234567890abcdefghijklmnopqrstuvwxyz\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/encrypt",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"encrypt"
							]
						},
						"description": "Example: Encrypt an API key or secret token"
					},
					"response": []
				}
			],
			"description": "Endpoints for encrypting and decrypting sensitive data with AES-256-GCM encryption."
		},
