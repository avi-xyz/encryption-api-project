# Terraform Variables for Encryption API
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git!

# AWS Configuration
aws_region  = "us-east-1"
environment = "development"

# Database Configuration
db_username = "admin"
db_password = "REPLACE_WITH_SECURE_PASSWORD"  # Generate with: openssl rand -base64 24

# Encryption Configuration
master_encryption_key = "REPLACE_WITH_BASE64_KEY"  # Generate with: openssl rand -base64 32

# S3 Bucket (for Lambda code)
s3_bucket_name = "your-lambda-code-bucket"

# Tags
project_name = "encryption-api"
